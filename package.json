{
  "name": "heic-jpeg",
  "author": {
    "name": "George MacKerron",
    "email": "george@mackerron.co.uk"
  },
  "repository": {
    "url": "git+https://github.com/jawj/heic-jpeg.git",
    "type": "git"
  },
  "version": "0.1.0",
  "description": "Convert HEIC to JPEG with ICC profile passthrough, using libheif and mozjpeg WASM builds",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "npm run build && node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "libheif-js": "^1.23.2",
    "wasm-mozjpeg": "github:3bl3gamer/wasm-mozjpeg"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.3.4"
}
